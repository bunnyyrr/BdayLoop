            "exec": [
              "pm.test(\"201\", () => pm.response.to.have.status(201));",
              "const u = pm.response.json();",
              "pm.collectionVariables.set(\"bobId\", u.id);",
              "pm.collectionVariables.set(\"bobUsername\", u.username);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
