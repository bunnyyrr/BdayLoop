{
  "info": {
    "name": "BdayLoop API",
    "description": "Контракт API: сквозной сценарий на двух пользователях (Алиса и Боб), в конце всё за собой удаляет. Запуск: Run collection по порядку; приложение и БД должны быть подняты",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "host",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "0. Выйти (на случай сессии от прошлого прогона)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{host}}/users/logout"
      }
    },
    {
      "name": "1. Без сессии → 401",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"401 text/plain\", () => {",
              "    pm.response.to.have.status(401);",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/plain\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{host}}/users"
      }
    },
    {
      "name": "2. Регистрация Алисы (именинница)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"201, дата строкой, без хэша\", () => {",
              "    pm.response.to.have.status(201);",
              "    const u = pm.response.json();",
              "    pm.expect(u.birthday).to.eql(\"2000-10-05\");",
              "    pm.expect(u.role).to.eql(\"USER\");",
              "    pm.expect(u).to.not.have.property(\"passwordHash\");",
              "    pm.collectionVariables.set(\"aliceId\", u.id);",
              "    pm.collectionVariables.set(\"aliceUsername\", u.username);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{host}}/users",
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Алиса\", \"birthday\": \"2000-10-05\", \"username\": \"alice_{{$timestamp}}\", \"password\": \"secret\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "3. Регистрация Боба (друг)",
